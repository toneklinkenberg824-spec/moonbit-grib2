///|
fn export_query(p : @grib2.Product) -> @grib2.FieldQuery {
  let criterion : @grib2.ForecastTimeFilter = match p.forecast_time {
    None => MissingTime
    Some(t) => ExactTime(t)
  }
  @grib2.FieldQuery::new(
    p.discipline,
    p.category,
    p.parameter,
    centre=p.centre,
    subcentre=p.subcentre,
    master_table=p.master_table,
    local_table=p.local_table,
    time_unit=p.time_unit,
    reference_time=p.reference_time,
    first_surface=p.first_surface,
    second_surface=p.second_surface,
  ).with_forecast_time_filter(criterion)
}

///|
/// Application boundary for complete records from this producer, not a general
/// fragmented/untrusted CSV reader. Keep only the header and current parsed row.
fn consume_records(
  case_name : String,
  records : Iter[String],
  maximum_rows? : Int,
) -> Unit raise {
  let options : @csv.CSVOptions = {
    delimiter: ',',
    allow_newlines_in_quotes: true,
    quote_char: '"',
    skip_empty_lines: true,
    trim_spaces: false,
  }
  let header = records.next().unwrap()
  let schema = @csv.CSV::parse_string(header, options~)
  let expected_header = [
    "request_key", "station_id", "latitude", "longitude", "value", "algorithm", "message",
    "field", "byte_offset", "product_json", "contributors_json",
  ]
  assert_eq(schema.header(), expected_header)
  assert_eq(schema.data().length(), 0)
  let mut consumed = 0
  while true {
    if maximum_rows is Some(n) && consumed >= n {
      break
    }
    match records.next() {
      None => break
      Some(record) => {
        // A logical CSV record may contain quoted physical CR/LF.
        let csv = @csv.CSV::parse_string(header + record, options~)
        assert_eq(csv.header(), expected_header)
        assert_eq(csv.shape(), (1, 11))
        let row = csv.data()[0]
        assert_eq(row.length(), 11)
        let value : Json = if row[4] == "" {
          Json::null()
        } else {
          @string.parse_double(row[4][:]).to_json()
        }
        let product = @json.parse(row[9][:])
        let contributors = @json.parse(row[10][:])
        let application_row : Json = {
          "kind": "row",
          "case": case_name.to_json(),
          "cells": row.to_json(),
          "value": value,
          "product": product,
          "contributors": contributors,
        }
        println(application_row.stringify())
        consumed += 1
      }
    }
  }
  let summary : Json = {
    "kind": "summary",
    "case": case_name.to_json(),
    "consumed_rows": consumed.to_json(),
  }
  println(summary.stringify())
}

