///|
fn octets(bytes : Bytes) -> Array[Int] {
  let out = []
  for i in 0..<bytes.length() {
    out.push(bytes[i].to_int())
  }
  out
}

///|
fn emit(value : Json) -> Unit {
  println(value.stringify())
}

///|
fn decode_error(error : @grib2.GribError) -> Json {
  match error {
    UnsupportedTemplate(section, template) =>
      {
        "kind": "unsupported-template",
        "section": section.to_json(),
        "template": template.to_json(),
      }
    CorruptedBitstream(message) =>
      { "kind": "corrupted-bitstream", "message": message.to_json() }
    InvalidRequest(message) =>
      { "kind": "invalid-request", "message": message.to_json() }
    InvalidGrid(message) =>
      { "kind": "invalid-grid", "message": message.to_json() }
    InvalidScanningMode(mode) =>
      { "kind": "invalid-scanning-mode", "mode": mode.to_json() }
  }
}

///|
fn optional_int(value : Int?) -> Json {
  match value {
    Some(value) => value.to_json()
    None => Json::null()
  }
}

///|
fn surface_json(surface : @grib2.Surface) -> Json {
  let value : Json = match surface.scaled_value {
    Some(value) => value.to_json()
    None => Json::null()
  }
  {
    "kind": surface.kind.to_json(),
    "scale": optional_int(surface.scale),
    "scaled_value": value,
  }
}

///|
fn product_json(product : @grib2.Product) -> Json {
  {
    "discipline": product.discipline.to_json(),
    "category": product.category.to_json(),
    "parameter": product.parameter.to_json(),
    "centre": product.centre.to_json(),
    "subcentre": product.subcentre.to_json(),
    "master_table": product.master_table.to_json(),
    "local_table": product.local_table.to_json(),
    "reference_time": product.reference_time.to_json(),
    "time_unit": product.time_unit.to_json(),
    "forecast_time": optional_int(product.forecast_time),
    "first_surface": surface_json(product.first_surface),
    "second_surface": surface_json(product.second_surface),
  }
}

///|
fn field_json(field : @grib2.GriddedField) -> Json {
  let values : Array[Json] = []
  for row in 0..<field.rows() {
    for col in 0..<field.cols() {
      values.push(
        match field.get(row, col) {
          Some(value) => value.to_json()
          None => Json::null()
        },
      )
    }
  }
  let local_bytes_json : Json = match field.local_use() {
    None => Json::null()
    Some(bytes) => octets(bytes).to_json()
  }
  {
    "rows": field.rows().to_json(),
    "cols": field.cols().to_json(),
    "values": values.to_json(),
    "mask": field.mask().to_json(),
    "origin": field.origin().to_json(),
    "product": product_json(field.product()),
    "local": local_bytes_json,
  }
}

///|
fn decoded(bytes : Bytes) -> Json {
  match @grib2.read_fields(bytes) {
    Ok(fields) => { "fields": fields.map(field_json).to_json() }
    Err(error) => { "error": decode_error(error) }
  }
}

///|
fn one_field(bytes : Bytes) -> Json {
  match @grib2.read_message(bytes) {
    Ok(field) => { "field": field_json(field) }
    Err(error) => { "error": decode_error(error) }
  }
}

///|
fn frame_error(error : @grib2.MessageFrameError) -> Json {
  match error {
    EmptyInput => { "code": "empty-input", "byte_offset": (0).to_json() }
    InvalidMagic(at) => { "code": "invalid-magic", "byte_offset": at.to_json() }
    TruncatedHeader(at) =>
      { "code": "truncated-header", "byte_offset": at.to_json() }
    UnsupportedEdition(at) =>
      { "code": "unsupported-edition", "byte_offset": at.to_json() }
    ShortMessageLength(at) =>
      { "code": "short-message-length", "byte_offset": at.to_json() }
    MessageLengthOutOfBounds(at) =>
      { "code": "message-length-out-of-bounds", "byte_offset": at.to_json() }
    InvalidEndMarker(at) =>
      { "code": "invalid-end-marker", "byte_offset": at.to_json() }
    MissingSection(at) =>
      { "code": "missing-section", "byte_offset": at.to_json() }
    TruncatedSectionHeader(at) =>
      { "code": "truncated-section-header", "byte_offset": at.to_json() }
    ShortSectionLength(at) =>
      { "code": "short-section-length", "byte_offset": at.to_json() }
    SectionLengthOutOfBounds(at) =>
      { "code": "section-length-out-of-bounds", "byte_offset": at.to_json() }
    InvalidSectionNumber(at) =>
      { "code": "invalid-section-number", "byte_offset": at.to_json() }
    InvalidFirstSection(at) =>
      { "code": "invalid-first-section", "byte_offset": at.to_json() }
  }
}

///|
fn inspect(name : String, bytes : Bytes) -> Unit {
  match @grib2.index_message_spans(bytes) {
    Err(error) => emit({ "case": name.to_json(), "error": frame_error(error) })
    Ok(spans) => {
      let receivers = spans.map(span => {
        let selected = bytes[span.byte_offset:span.byte_offset + span.length].to_owned()
        let row : Json = {
          "span": span.to_json(),
          "raw": octets(selected).to_json(),
          "decoded": decoded(selected),
          "one": one_field(selected),
        }
        row
      })
      emit({
        "case": name.to_json(),
        "spans": spans.to_json(),
        "receivers": receivers.to_json(),
        "whole": decoded(bytes),
      })
    }
  }
}

