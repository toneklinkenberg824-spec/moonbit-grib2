///|
fn export_query(p : @grib2.Product) -> @grib2.FieldQuery {
  let criterion : @grib2.ForecastTimeFilter = match p.forecast_time {
    None => MissingTime
    Some(t) => ExactTime(t)
  }
  @grib2.FieldQuery::new(
    p.discipline,
    p.category,
    p.parameter,
    centre=p.centre,
    subcentre=p.subcentre,
    master_table=p.master_table,
    local_table=p.local_table,
    time_unit=p.time_unit,
    reference_time=p.reference_time,
    first_surface=p.first_surface,
    second_surface=p.second_surface,
  ).with_forecast_time_filter(criterion)
}

