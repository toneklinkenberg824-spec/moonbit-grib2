///|
fn unique_outcome(
  fields : ArrayView[@grib2.GriddedField],
  query : @grib2.FieldQuery,
) -> Json raise {
  match @grib2.select_unique_field(fields, query) {
    Ok(field) =>
      {
        "kind": "unique",
        "origin": ToJson::to_json(field.origin()),
        "product": ToJson::to_json(field.product()),
        "value": field.get(1, 1).unwrap().to_json(),
      }
    Err(InvalidRequest(message)) =>
      { "kind": "invalid-request", "message": message.to_json() }
    Err(_) => fail("unexpected selection error")
  }
}

///|
fn batch_outcome(
  fields : ArrayView[@grib2.GriddedField],
  query : @grib2.FieldQuery,
) -> Json raise {
  match
    @grib2.sample_requested_fields(fields, [{ key: "probe", query, }], [
      { id: "site", latitude: 0.0, longitude: 11.0, },
    ]) {
    Ok(groups) =>
      {
        "kind": "unique",
        "origin": ToJson::to_json(groups[0].origin),
        "product": ToJson::to_json(groups[0].product),
        "value": groups[0].samples[0].value.unwrap().to_json(),
      }
    Err(InvalidRequest(message)) =>
      { "kind": "invalid-request", "message": message.to_json() }
    Err(_) => fail("unexpected batch selection error")
  }
}

///|
fn queries() -> Array[(String, @grib2.FieldQuery)] {
  let a : @grib2.Surface = {
    kind: 100,
    scale: Some(0),
    scaled_value: Some(85000U),
  }
  let b : @grib2.Surface = {
    kind: 100,
    scale: Some(1),
    scaled_value: Some(850000U),
  }
  let height : @grib2.Surface = {
    kind: 103,
    scale: Some(0),
    scaled_value: Some(2U),
  }
  [
    (
      "absent-level-time",
      @grib2.FieldQuery::new(0, 0, 0, first_surface=height, forecast_time=6),
    ),
    (
      "unique-encoded-A",
      @grib2.FieldQuery::new(
        0,
        0,
        0,
        first_surface=a,
        reference_time=[2007, 3, 23, 12, 0, 0],
        forecast_time=6,
      ),
    ),
    (
      "ambiguous-A-any-run",
      @grib2.FieldQuery::new(0, 0, 0, first_surface=a, forecast_time=6),
    ),
    ("forecast-six-any-layer", @grib2.FieldQuery::new(0, 0, 0, forecast_time=6)),
    (
      "missing-time",
      @grib2.FieldQuery::new(0, 0, 0).with_forecast_time_filter(MissingTime),
    ),
    ("analysis-zero", @grib2.FieldQuery::new(0, 0, 0, forecast_time=0)),
    (
      "encoded-B",
      @grib2.FieldQuery::new(
        0,
        0,
        0,
        first_surface=b,
        reference_time=[2007, 3, 23, 12, 0, 0],
        forecast_time=6,
      ),
    ),
    (
      "same-parameter-any",
      @grib2.FieldQuery::new(
        0,
        0,
        0,
        centre=98,
        subcentre=0,
        master_table=4,
        local_table=0,
        time_unit=1,
        second_surface={ kind: 255, scale: None, scaled_value: None, },
      ),
    ),
    (
      "other-parameter-minutes",
      @grib2.FieldQuery::new(0, 0, 1, time_unit=0, forecast_time=360),
    ),
    (
      "no-unit-conversion",
      @grib2.FieldQuery::new(0, 0, 1, time_unit=1, forecast_time=6),
    ),
    (
      "time-unit-mismatch",
      @grib2.FieldQuery::new(0, 0, 1, time_unit=1, forecast_time=360),
    ),
    ("different-centre", @grib2.FieldQuery::new(0, 0, 0, centre=99)),
  ]
}

///|
fn inspect_outcome(
  fields : ArrayView[@grib2.GriddedField],
  query : @grib2.FieldQuery,
) -> Json raise {
  match @grib2.inspect_field_query(fields, query) {
    Ok(report) => { "kind": "report", "report": ToJson::to_json(report) }
    Err(InvalidRequest(message)) =>
      { "kind": "invalid-request", "message": message.to_json() }
    Err(_) => fail("unexpected query inspection error")
  }
}

///|
fn emit_case(
  name : String,
  fields : ArrayView[@grib2.GriddedField],
  query : @grib2.FieldQuery,
) -> Unit raise {
  let row : Json = {
    "case": name.to_json(),
    "inspection": inspect_outcome(fields, query),
    "unique": unique_outcome(fields, query),
    "batch": batch_outcome(fields, query),
  }
  println(row.stringify())
}

