///|
fn report(
  name : String,
  field : @grib2.GriddedField,
  station : @grib2.Station,
) -> Unit {
  let event : Json = match field.sample_result(station) {
    Ok(sample) =>
      {
        "phase": "sample",
        "case": name.to_json(),
        "code": "available",
        "sample": sample.to_json(),
      }
    Err(reason) =>
      {
        "phase": "sample",
        "case": name.to_json(),
        "code": ToJson::to_json(reason),
        "station": station.to_json(),
        "origin": field.origin().to_json(),
        "product": ToJson::to_json(field.product()),
      }
  }
  println(event.stringify())
}

