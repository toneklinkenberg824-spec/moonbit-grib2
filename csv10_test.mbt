  let groups = @grib2.sample_requested_fields(
    fs,
    [{ key: "known", query: @grib2.FieldQuery::new(0, 0, 0, forecast_time=0), }],
    [],
  ).unwrap()
  let expected = "\"request_key\",\"station_id\",\"latitude\",\"longitude\",\"value\",\"algorithm\",\"message\",\"field\",\"byte_offset\",\"product_json\",\"contributors_json\"\r\n"
