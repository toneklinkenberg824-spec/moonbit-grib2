///|
test "duplicate longitude endpoint is checked and counted once" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xc9\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x0a\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x05\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x00\x00\x00\x30\x00\x00\x00\x00\x15\x75\x2a\x00\x05\x5d\x4a\x80\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x0a\x00\x00\x3f\x80\x00\x00\x80\x0d\x00\x00\x11\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x1b\x07\x00\x00\x08\x00\x08\x00\x06\x00\x00\x00\x05\x00\x02\xc0\x01\x80\x00\xd0\x00\x50\x00\x00\x37\x37\x37\x37",
  ).unwrap()
  assert_eq(f.cols(), 5)
  assert_eq(f.is_global(), true)
  assert_eq(f.interpolate_latlon(1.0, 315.0), Some(2.5))
  assert_eq(
    f
    .crop({ south: 0.0, north: 1.0, west: 0.0, east: 360.0, })
    .unwrap()
    .length(),
    8,
  )
  assert_true(
    @grib2.read_message(
      b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xc9\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x0a\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x05\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x00\x00\x00\x30\x00\x00\x00\x00\x15\x75\x2a\x00\x05\x5d\x4a\x80\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x0a\x00\x00\x3f\x80\x00\x00\x80\x0a\x00\x00\x11\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x1b\x07\x00\x00\x01\x00\x01\x00\x00\xc0\x0c\x40\x00\xa0\x00\x58\x00\x30\x00\x1a\x00\x0a\x00\x00\x37\x37\x37\x37",
    )
    is Err(InvalidGrid(_)),
  )
}

///|
test "polar masks, vector exclusion, invalid requests and resource limit" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xc4\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x0c\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x04\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x05\x5d\x4a\x80\x00\x00\x00\x00\x30\x85\x5d\x4a\x80\x10\x17\xdf\x80\x05\x5d\x4a\x80\x05\x5d\x4a\x80\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x07\x00\x00\x40\x00\x00\x00\x80\x0d\x00\x00\x11\x00\x00\x00\x00\x08\x06\x00\x7f\x00\x00\x00\x00\x14\x07\x00\x00\x10\x00\x10\x00\x10\x00\x0a\x00\x06\x00\x03\x80\x00\x37\x37\x37\x37",
  ).unwrap()
  assert_eq(f.interpolate_latlon(90.0, 0.0), Some(4.0))
  assert_eq(f.interpolate_latlon(-90.0, 0.0), None)
  assert_eq(f.interpolate_latlon(-45.0, 0.0), None)
  assert_eq(f.interpolate_latlon(0.0, 0.0), Some(10.0))
  assert_eq(f.interpolate_latlon(91.0, 0.0), None)
  assert_eq(f.interpolate_latlon(0.0, 0.0 / 0.0), None)
  let w = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xcd\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x0c\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x04\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x05\x5d\x4a\x80\x00\x00\x00\x00\x30\x85\x5d\x4a\x80\x10\x17\xdf\x80\x05\x5d\x4a\x80\x05\x5d\x4a\x80\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x02\x02\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x0c\x00\x00\x00\x00\x00\x00\x80\x0c\x00\x00\x11\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x1f\x07\x00\x00\x08\x00\x08\x00\x06\x00\x05\x00\x03\x00\x01\xc0\x01\x00\x00\xa0\x00\x58\x00\x30\x00\x1a\x00\x00\x37\x37\x37\x37",
  ).unwrap()
  assert_eq(w.interpolate_latlon(90.0, 0.0), None)
  assert_true(
    @grib2.read_message(
      b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xc9\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x0a\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x05\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x00\x00\x00\x30\x00\x00\x00\x00\x15\x75\x2a\x00\x05\x5d\x4a\x80\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x0a\x00\x00\x3f\x80\x00\x00\x80\x0d\x00\x00\x11\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x1b\x07\x00\x00\x08\x00\x08\x00\x06\x00\x00\x00\x05\x00\x02\xc0\x01\x80\x00\xd0\x00\x50\x00\x00\x37\x37\x37\x37",
      max_points=2,
    )
    is Err(InvalidGrid(_)),
  )
  assert_true(
    @grib2.read_message(
      b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xc9\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x0a\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x05\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x00\x00\x00\x30\x00\x00\x00\x00\x15\x75\x2a\x00\x05\x5d\x4a\x80\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x0a\x00\x00\x3f\x80\x00\x00\x80\x0d\x00\x00\x11\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x1b\x07\x00\x00\x08\x00\x08\x00\x06\x00\x00\x00\x05\x00\x02\xc0\x01\x80\x00\xd0\x00\x50\x00\x00\x37\x37\x37\x37",
      max_points=0,
    )
    is Err(InvalidRequest(_)),
  )
}
