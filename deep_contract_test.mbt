///|
test "deep combined bitmap scan0" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb5\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x06\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x98\x96\x80\x30\x00\x00\x00\x00\x00\xb7\x1b\x00\x00\x0f\x42\x40\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x07\x06\x00\xb0\x00\x00\x00\x06\x07\x6c\x37\x37\x37\x37",
  ).unwrap()
  let expected : Array[Double] = [1.0, 0.0, 2.0, 3.0, 0.0, 0.0]
  let valid = [true, false, true, true, false, false]
  let source = [0, 1, 2, 3, 4, 5]
  for r in 0..<2 {
    for c in 0..<3 {
      let i = r * 3 + c
      let p = f.point(r, c).unwrap()
      assert_eq(p.source_index, source[i])
      assert_eq(p.latitude, 1.0 - r.to_double())
      assert_eq(p.longitude, 10.0 + c.to_double())
      assert_eq(f.mask()[i], valid[i])
      if valid[i] {
        assert_eq(p.value, Some(expected[i]))
      } else {
        assert_eq(p.value, None)
      }
    }
  }
}

