  ).unwrap()
  let valid = [true, false, true, false, true, false]
  let expected : Double = 1.0
  assert_eq(f.mask(), valid)
  for r in 0..<2 {
    for c in 0..<3 {
      let i = r * 3 + c
      if valid[i] {
        assert_eq(f.get(r, c), Some(expected))
