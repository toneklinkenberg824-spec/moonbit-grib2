// WMO92.9.4 independent Decimal oracle; generated binary fixtures, not product outputs.

///|
test "constant scale D1 no-bitmap" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb3\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x06\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x98\x96\x80\x30\x00\x00\x00\x00\x00\xb7\x1b\x00\x00\x0f\x42\x40\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x06\x00\x00\x41\x20\x00\x00\x00\x03\x00\x01\x00\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x05\x07\x37\x37\x37\x37",
  ).unwrap()
  let valid = [true, true, true, true, true, true]
  let expected : Double = 1.0
  assert_eq(f.mask(), valid)
  for r in 0..<2 {
    for c in 0..<3 {
      let i = r * 3 + c
      if valid[i] {
        assert_eq(f.get(r, c), Some(expected))
        assert_eq(f.values()[i], expected)
        assert_eq(
          f.interpolate_latlon(1.0 - r.to_double(), 10.0 + c.to_double()),
          Some(expected),
        )
      } else {
        assert_eq(f.get(r, c), None)
        assert_true(f.values()[i].is_nan())
      }
    }
  }
}

