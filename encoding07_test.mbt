///|
test "encoding07 legal exact_north has physical public coordinate" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb3\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x06\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x01\x00\x00\x00\x5d\x00\x00\x20\xb2\x00\x00\x00\x00\x30\x00\x00\x20\x55\x00\x00\x00\xba\x00\x00\x00\x5d\x00\x00\x00\x5d\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x06\x00\x00\x40\xe0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x05\x07\x37\x37\x37\x37",
  ).unwrap()
  let p = f.point(0, 0).unwrap()
  assert_eq(p.latitude, 90.0)
  let s = f.sample({ id: "pole", latitude: p.latitude, longitude: p.longitude, })
  assert_true((s.value.unwrap() - 7.0).abs() < 1.0e-12)
  for c in s.contributors {
    assert_eq(c.latitude, 90.0)
  }
  let nodes = f
    .crop({ south: 90.0, north: 90.0, west: 0.0, east: 360.0, })
    .unwrap()
  assert_eq(nodes.length(), 3)
}

