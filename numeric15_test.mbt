///|
fn numeric15_near(actual : Double?, expected : Double) -> Unit raise {
  let value = actual.unwrap()
  assert_true(!value.is_nan() && !value.is_inf())
  assert_true((value - expected).abs() / expected.abs() <= 4.0e-15)
}

///|
test "numeric15 finite polar constants and adjacent bands" {
  for
    field in [
      numeric15_positive11(),
      numeric15_positive17(),
      numeric15_positive100(),
    ] {
    for col in 0..<field.cols() {
      assert_eq(field.get(0, col), Some(1.7976931348623157e308))
    }
    let pole = field.sample({
      id: "north-pole",
      latitude: 90.0,
      longitude: 15.0,
    })
    assert_eq(pole.value, Some(1.7976931348623157e308))
    assert_eq(pole.algorithm, "bilinear-polar-scalar-mean")
    assert_eq(pole.contributors.length(), field.cols())
    numeric15_near(
      field.sample({ id: "north-band", latitude: 89.5, longitude: 15.5, }).value,
      1.7976931348623157e308,
    )
  }
}

///|
test "numeric15 negative south pole and adjacent band" {
  for field in [numeric15_negative11(), numeric15_negative17()] {
    for col in 0..<field.cols() {
      assert_eq(field.get(1, col), Some(-1.7976931348623157e308))
    }
    let pole = field.sample({
      id: "south-pole",
      latitude: -90.0,
      longitude: 15.0,
    })
    assert_eq(pole.value, Some(-1.7976931348623157e308))
    numeric15_near(
      field.sample({ id: "south-band", latitude: -89.5, longitude: 15.5, }).value,
      -1.7976931348623157e308,
    )
  }
}

///|
test "numeric15 varying finite near-limit row follows exact mean" {
  let field = numeric15_varying100()
  let pole = field.sample({
    id: "varying-pole",
    latitude: 90.0,
    longitude: 10.25,
  })
  numeric15_near(pole.value, 1.797693134862314e+308)
  let lower = field.get(0, 99).unwrap()
  assert_true(
    pole.value.unwrap() >= lower &&
    pole.value.unwrap() <= field.get(0, 0).unwrap(),
  )
  numeric15_near(
    field.sample({ id: "varying-band", latitude: 89.5, longitude: 10.25, }).value,
    1.7976931348623147e+308,
  )
  println("NUMERIC15|varying|" + pole.to_json().stringify())
}

///|
test "numeric15 overflow retry preserves positive-weight gaps and wind policy" {
  let field = numeric15_gap11()
  assert_eq(field.get(1, 5), None)
  let gap = field.sample({ id: "gap", latitude: 89.5, longitude: 15.5, })
  assert_eq(gap.value, None)
  assert_eq(gap.contributors.length(), 0)
  assert_eq(gap.algorithm, "outside-or-missing")
  assert_eq(
    field.sample({ id: "exact", latitude: 89.0, longitude: 16.0, }).value,
    Some(1.7976931348623157e308),
  )
  assert_eq(
    field.sample({ id: "valid-pole", latitude: 90.0, longitude: 16.0, }).value,
    Some(1.7976931348623157e308),
  )
  let wind = numeric15_wind11()
  assert_eq(
    wind.sample({ id: "wind-pole", latitude: 90.0, longitude: 15.0, }).value,
    None,
  )
  assert_eq(
    wind.sample({ id: "wind-node", latitude: 89.0, longitude: 15.0, }).value,
    Some(1.7976931348623157e308),
  )
}
