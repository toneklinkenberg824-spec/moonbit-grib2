  ).unwrap()
  assert_eq(fs[0].product().forecast_time, None)
  assert_eq(fs[1].product().forecast_time, Some(0))
  assert_true(
    @grib2.select_unique_field(
      fs,
      @grib2.FieldQuery::new(
        0,
        0,
        0,
        time_unit=1,
        reference_time=[2007, 3, 23, 12, 0, 0],
        first_surface={ kind: 103, scale: Some(0), scaled_value: Some(2U), },
        second_surface={ kind: 255, scale: None, scaled_value: None, },
      ),
    )
    is Err(InvalidRequest(_)),
  )
  let exact = @grib2.select_unique_field(
    fs,
    @grib2.FieldQuery::new(0, 0, 0, forecast_time=0),
  ).unwrap()
  assert_eq(exact.origin().message, 1)
  println(
    "BEFORE_GAP: wildcard=ambiguous; exact0=message1; encoded-missing=message0 requires manual filter",
  )
}
