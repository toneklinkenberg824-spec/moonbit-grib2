///|
fn forecast09_query() -> @grib2.FieldQuery {
  @grib2.FieldQuery::new(
    0,
    0,
    0,
    time_unit=1,
    reference_time=[2007, 3, 23, 12, 0, 0],
    first_surface={ kind: 103, scale: Some(0), scaled_value: Some(2U), },
    second_surface={ kind: 255, scale: None, scaled_value: None, },
  )
}

///|
test "forecast09 distinguish missing zero positive negative and wildcard" {
  let fs = forecast09_fields()
  let q = forecast09_query()
  assert_eq(q.forecast_time_filter(), AnyTime)
  assert_true(@grib2.select_unique_field(fs, q) is Err(InvalidRequest(_)))
  let filters : Array[@grib2.ForecastTimeFilter] = [
    MissingTime,
    ExactTime(0),
    ExactTime(6),
    ExactTime(-6),
  ]
  let times = [None, Some(0), Some(6), Some(-6)]
  let values = [111.0, 222.0, 333.0, 444.0]
  for i, filter in filters {
    let refined = q.with_forecast_time_filter(filter)
    assert_eq(refined.forecast_time_filter(), filter)
    let f = @grib2.select_unique_field(fs, refined).unwrap()
    assert_eq(f.origin().message, i)
    assert_eq(f.product().forecast_time, times[i])
    assert_eq(f.get(1, 0), Some(values[i]))
  }
}

///|
test "forecast09 immutable criterion transitions preserve other filters" {
  let fs = forecast09_fields()
  let original = @grib2.FieldQuery::new(0, 0, 0, time_unit=1, forecast_time=6)
  let missing = original.with_forecast_time_filter(MissingTime)
  assert_eq(original.forecast_time, Some(6))
  assert_eq(original.forecast_time_filter(), ExactTime(6))
  assert_eq(missing.forecast_time, None)
  assert_eq(missing.forecast_time_filter(), MissingTime)
  assert_eq(
    @grib2.select_unique_field(fs, original).unwrap().origin().message,
    2,
  )
  assert_eq(
    @grib2.select_unique_field(fs, missing).unwrap().origin().message,
    0,
  )
  assert_eq(
    @grib2.select_unique_field(
      fs,
      missing.with_forecast_time_filter(ExactTime(0)),
    )
    .unwrap()
    .origin().message,
    1,
  )
  assert_true(
    @grib2.select_unique_field(fs, missing.with_forecast_time_filter(AnyTime))
    is Err(InvalidRequest(_)),
  )
  let wrong = @grib2.FieldQuery::new(0, 0, 0, time_unit=13).with_forecast_time_filter(
    MissingTime,
  )
  assert_true(@grib2.select_unique_field(fs, wrong) is Err(InvalidRequest(_)))
  let wrong_layer = @grib2.FieldQuery::new(0, 0, 0, first_surface={
    kind: 100,
    scale: Some(0),
    scaled_value: Some(85000U),
  }).with_forecast_time_filter(MissingTime)
  assert_true(
    @grib2.select_unique_field(fs, wrong_layer) is Err(InvalidRequest(_)),
  )
}

///|
test "forecast09 named batch keeps raw missing metadata and Unicode labels" {
  let fs = forecast09_fields()
  let q = forecast09_query()
  let requests : Array[@grib2.FieldRequest] = [
    {
      key: "未指定时效,\"原始\"\n组",
      query: q.with_forecast_time_filter(MissingTime),
    },
    { key: "分析0", query: q.with_forecast_time_filter(ExactTime(0)), },
  ]
  let stations : Array[@grib2.Station] = [
    { id: "站点 A,\"夜间\"\n第二行", latitude: 1.0, longitude: 10.0, },
    { id: "内陆", latitude: 0.0, longitude: 10.5, },
  ]
  let out = @grib2.sample_requested_fields(fs, requests, stations).unwrap()
  assert_eq(out[0].key, "未指定时效,\"原始\"\n组")
  assert_eq(out[0].samples[0].station.id, "站点 A,\"夜间\"\n第二行")
  assert_eq(out[0].product.forecast_time, None)
  assert_eq(out[1].product.forecast_time, Some(0))
  assert_eq(out[0].origin.message, 0)
  assert_eq(out[1].origin.byte_offset, 180)
  assert_eq(out[0].samples[0].value, None)
  assert_eq(out[0].samples[1].value, Some(111.0))
  assert_eq(out[1].samples[0].value, Some(222.0))
  assert_eq(out[0].samples[1].contributors[0].source_index, 3)
  assert_eq(out[0].samples[1].contributors[1].source_index, 4)
}

