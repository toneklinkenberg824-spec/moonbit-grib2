///|
test "boundary06 isolated valid southeast node" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb6\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x09\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x98\x96\x80\x00\x98\x96\x80\x30\x00\x98\x96\x7e\x00\x98\x96\x82\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x08\x06\x00\x00\x80\x00\x00\x00\x06\x07\x90\x37\x37\x37\x37",
  ).unwrap()
  let p = f.point(2, 2).unwrap()
  assert_eq(f.interpolate_latlon(p.latitude, p.longitude), Some(9.0))
  assert_eq(f.interpolate_latlon(p.latitude + f.dy * 0.125, p.longitude), None)
  assert_eq(f.interpolate_latlon(p.latitude, p.longitude - f.dx * 0.125), None)
}

///|
test "boundary06 dateline meridian extraction" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb8\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x09\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x98\x96\x80\x15\x75\x29\xfe\x30\x00\x98\x96\x7e\x15\x75\x2a\x00\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x0a\x07\x12\x34\x56\x78\x90\x37\x37\x37\x37",
  ).unwrap()
  for c in 0..<3 {
    let p = f.point(0, c).unwrap()
    let nodes = f
      .crop({
        south: f.point(2, 0).unwrap().latitude,
        north: p.latitude,
        west: p.longitude,
        east: p.longitude,
      })
      .unwrap()
    assert_eq(nodes.length(), 3)
    for n in nodes {
      assert_eq(n.col, c)
    }
    assert_eq(f.interpolate_latlon(p.latitude, p.longitude), p.value)
  }
}
