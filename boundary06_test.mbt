///|
test "boundary06 microdegree all public nodes round trip" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb8\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x09\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x98\x96\x80\x00\x98\x96\x80\x30\x00\x98\x96\x7e\x00\x98\x96\x82\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x0a\x07\x12\x34\x56\x78\x90\x37\x37\x37\x37",
  ).unwrap()
  for r in 0..<3 {
    for c in 0..<3 {
      let p = f.point(r, c).unwrap()
      assert_eq(f.get(r, c), Some((1 + r * 3 + c).to_double()))
      let s = f.sample({
        id: "node",
        latitude: p.latitude,
        longitude: p.longitude,
      })
      assert_eq(s.value, p.value)
      assert_eq(s.contributors.length(), 1)
      assert_eq(s.contributors[0].source_index, p.source_index)
      assert_eq(s.contributors[0].weight, 1.0)
    }
  }
}

///|
test "boundary06 microdegree crop exact public nodes and closed edges" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb8\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x09\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x98\x96\x80\x00\x98\x96\x80\x30\x00\x98\x96\x7e\x00\x98\x96\x82\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x0a\x07\x12\x34\x56\x78\x90\x37\x37\x37\x37",
  ).unwrap()
  for r in 0..<3 {
    for c in 0..<3 {
      let p = f.point(r, c).unwrap()
      let nodes = f
        .crop({
          south: p.latitude,
          north: p.latitude,
          west: p.longitude,
          east: p.longitude,
        })
        .unwrap()
      assert_eq(nodes.length(), 1)
      assert_eq(nodes[0].row, r)
      assert_eq(nodes[0].col, c)
    }
  }
  let a = f.point(0, 0).unwrap()
  let z = f.point(2, 1).unwrap()
  let nodes = f
    .crop({
      south: z.latitude,
      north: a.latitude,
      west: a.longitude,
      east: z.longitude,
    })
    .unwrap()
  assert_eq(nodes.length(), 6)
  for i, p in nodes {
    assert_eq(p.row, i / 2)
    assert_eq(p.col, i % 2)
  }
  let empty = f
    .crop({
      south: z.latitude,
      north: a.latitude,
      west: a.longitude + f.dx * 0.25,
      east: a.longitude + f.dx * 0.5,
    })
    .unwrap()
  assert_eq(empty.length(), 0)
}

///|
test "boundary06 microdegree no neighbour extrapolation" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb8\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x09\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x98\x96\x80\x00\x98\x96\x80\x30\x00\x98\x96\x7e\x00\x98\x96\x82\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x0a\x07\x12\x34\x56\x78\x90\x37\x37\x37\x37",
  ).unwrap()
  let a = f.point(0, 0).unwrap()
  let z = f.point(2, 2).unwrap()
  assert_eq(f.interpolate_latlon(z.latitude - f.dy * 0.125, z.longitude), None)
  assert_eq(f.interpolate_latlon(a.latitude + f.dy * 0.125, a.longitude), None)
  assert_eq(f.interpolate_latlon(a.latitude, a.longitude - f.dx * 0.125), None)
  assert_eq(f.interpolate_latlon(z.latitude, z.longitude + f.dx * 0.125), None)
  // Fine angular units can put an outside inverse coordinate beyond Int32.
  assert_eq(f.interpolate_latlon(-90.0, 180.0), None)
}

