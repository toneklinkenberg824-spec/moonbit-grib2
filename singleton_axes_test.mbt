///|
test "singleton axes row stays on represented latitude" {
  let field = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb6\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x03\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x01\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x98\x96\x80\x20\x00\x0f\x42\x40\x00\xb7\x1b\x00\x00\x0f\x42\x40\x00\x00\x00\x00\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x67\x00\x00\x00\x00\x02\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x08\x07\x28\x32\x3c\x37\x37\x37\x37",
  ).unwrap()
  assert_eq(field.rows(), 1)
  assert_eq(field.cols(), 3)
  assert_eq(field.dy, 0.0)
  assert_eq(
    field.sample({ id: "mid", latitude: 1.0, longitude: 10.5, }).value,
    Some(45.0),
  )
  assert_true(
    field.sample_result({ id: "off", latitude: 1.0000001, longitude: 10.5, })
    is Err(OutsideGrid),
  )
}

///|
test "singleton axes column with missing step preserves linear weights" {
  let field = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb6\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x03\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x1e\x84\x80\x00\x98\x96\x80\x10\x00\x00\x00\x00\x00\x98\x96\x80\xff\xff\xff\xff\x00\x0f\x42\x40\x10\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x67\x00\x00\x00\x00\x02\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x08\x07\x0a\x14\x1e\x37\x37\x37\x37",
  ).unwrap()
  assert_eq(field.dx, 0.0)
  let value = field
    .sample_result({ id: "mid", latitude: 1.5, longitude: 10.0, })
    .unwrap()
  assert_eq(value.value, Some(15.0))
  assert_eq(value.contributors.length(), 2)
  assert_eq(value.contributors[0].weight, 0.5)
  assert_true(
    field.sample_result({ id: "off", latitude: 1.5, longitude: 10.0000001, })
    is Err(OutsideGrid),
  )
}

///|
test "singleton axes point aliases longitude without area extrapolation" {
  let field = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb4\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x01\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x01\x00\x00\x00\x01\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x00\x00\x00\x00\x00\x0f\x42\x40\x15\x75\x2a\x00\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x67\x00\x00\x00\x00\x02\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x06\x07\x09\x37\x37\x37\x37",
  ).unwrap()
  assert_eq(field.dx, 0.0)
  assert_eq(field.dy, 0.0)
  assert_eq(field.is_global(), false)
  assert_eq(
    field.sample({ id: "alias", latitude: 1.0, longitude: 360.0, }).value,
    Some(9.0),
  )
  assert_true(
    field.sample_result({ id: "off", latitude: 1.0, longitude: 1.0, })
    is Err(OutsideGrid),
  )
}

///|
test "singleton axes retain existing positive cyclic spacing" {
  let field = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb6\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x03\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x1e\x84\x80\x00\x98\x96\x80\x30\x00\x00\x00\x00\x00\x98\x96\x80\x15\x75\x2a\x00\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x67\x00\x00\x00\x00\x02\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x08\x07\x0a\x14\x1e\x37\x37\x37\x37",
  ).unwrap()
  assert_eq(field.dx, 360.0)
  assert_eq(field.is_global(), true)
  assert_eq(
    field.sample({ id: "far", latitude: 1.5, longitude: 200.0, }).value,
    Some(15.0),
  )
}
