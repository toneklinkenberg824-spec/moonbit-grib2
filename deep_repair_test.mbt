///|
test "deep exact public node ignores zero-weight missing corners" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb6\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x09\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x03\x00\x00\x00\x00\xff\xff\xff\xff\x00\x98\x96\x80\x00\x98\x96\x80\x30\x00\x95\x89\x40\x00\x9b\xa3\xc0\x00\x01\x86\xa0\x00\x01\x86\xa0\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x08\x06\x00\x08\x00\x00\x00\x00\x06\x07\x50\x37\x37\x37\x37",
  ).unwrap()
  let p = f.point(1, 1).unwrap()
  assert_eq(f.get(1, 1), Some(5.0))
  assert_eq(f.interpolate_latlon(p.latitude, p.longitude), Some(5.0))
  assert_eq(f.interpolate_latlon(9.9, 10.1), Some(5.0))
  assert_eq(f.interpolate_latlon(9.90000000001, 10.1), None)
}

