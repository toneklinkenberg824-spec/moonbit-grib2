///|
test "deep numeric normal-width-2-scale0" {
  let f = @grib2.read_message(
    b"\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb5\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x06\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x98\x96\x80\x30\x00\x00\x00\x00\x00\xb7\x1b\x00\x00\x0f\x42\x40\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x06\x00\x00\xbf\xa0\x00\x00\x80\x05\x80\x02\x02\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x07\x07\x1b\xd0\x37\x37\x37\x37",
  ).unwrap()
  let expected : Array[Double] = [
    -125.0, -121.875, -118.75, -115.625, -115.625, -121.875,
  ]
  let mut max_relative = 0.0
  for i in 0..<6 {
    let actual = f.values()[i]
    assert_true(!actual.is_nan() && !actual.is_inf())
    if expected[i] != 0.0 {
      assert_true(actual != 0.0)
    }
    if expected[i] != 0.0 {
      let relative = ((actual - expected[i]) / expected[i]).abs()
      if relative > max_relative {
        max_relative = relative
      }
    }
    if expected[i].abs() < 1.0e-290 {
      assert_true((actual - expected[i]).abs() <= 5.0e-324)
    } else {
      assert_true(
        (actual - expected[i]).abs() <= expected[i].abs() * 2.0e-12 + 1.0e-300,
      )
    }
  }
  println("DEEP_NUMERIC|normal-width-2-scale0|" + max_relative.to_string())
}

