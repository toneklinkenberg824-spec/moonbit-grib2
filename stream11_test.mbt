ff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x06\x00\x00\x43\xa6\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x05\x07\x37\x37\x37\x37\x47\x52\x49\x42\xff\xff\x00\x02\x00\x00\x00\x00\x00\x00\x00\xb3\x00\x00\x00\x15\x01\x00\x62\x00\x00\x04\x00\x01\x07\xd7\x03\x17\x0c\x00\x00\x00\x02\x00\x00\x00\x48\x03\x00\x00\x00\x00\x06\x00\x00\x00\x00\x06\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x00\xff\xff\xff\xff\x00\x0f\x42\x40\x00\x98\x96\x80\x30\x00\x00\x00\x00\x00\xb7\x1b\x00\x00\x0f\x42\x40\x00\x0f\x42\x40\x00\x00\x00\x00\x22\x04\x00\x00\x00\x00\x00\x00\x00\xff\x80\x00\x00\x00\x01\x80\x00\x00\x06\x67\x00\x00\x00\x00\x02\xff\xff\xff\xff\xff\xff\x00\x00\x00\x15\x05\x00\x00\x00\x06\x00\x00\x43\xde\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x06\xff\x00\x00\x00\x05\x07\x37\x37\x37\x37",
  ).unwrap()
  let stations : Array[@grib2.Station] = Array::make(10000, {
    id: "bulk",
    latitude: 0.0,
    longitude: 10.5,
  })
  let groups = @grib2.sample_requested_fields(
    fields,
    [
      {
        key: "bulk",
        query: @grib2.FieldQuery::new(0, 0, 0, time_unit=1).with_forecast_time_filter(
          MissingTime,
        ),
      },
    ],
    stations,
  ).unwrap()
  let stream = @grib2.station_csv_records(groups)
  let header = stream.next().unwrap()
  let first = stream.next().unwrap()
  println("STREAM11|prefix|" + [header, first].to_json().stringify())
  let mut count = 2
  let mut total = header.length() + first.length()
  let mut maximum = first.length()
  for chunk in stream {
    count += 1
    total += chunk.length()
    if chunk.length() > maximum {
      maximum = chunk.length()
    }
  }
  assert_eq(count, 10001)
  assert_eq(total, header.length() + 10000 * first.length())
  assert_eq(maximum, first.length())
  assert_eq(stream.next(), None)
  let stats : Json = {
    "records": count.to_json(),
    "serialized_units": total.to_json(),
    "maximum_record_units": maximum.to_json(),
    "prefix_records": (2).to_json(),
  }
  println("STREAM11|stats|" + stats.stringify())
}
